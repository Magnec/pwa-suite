/**
 * Implements hook_install().
 *
 * Kurulumda çalışır: tablolar hook_schema() ile zaten oluşturulur.
 * Fiziksel dosyaları oluşturmayı dene (izin yoksa sessizce geç).
 */
function pwa_suite_install(): void {
  try {
    \Drupal\pwa_suite\PwaStaticFiles::writeAll(
      \Drupal::configFactory(),
      \Drupal::state(),
      \Drupal::moduleHandler(),
    );
  }
  catch (\Exception $e) {
    \Drupal::logger('pwa_suite')->warning(
      'Kurulum: statik dosyalar oluşturulamadı — @msg',
      ['@msg' => $e->getMessage()]
    );
  }
}

/**
 * Implements hook_uninstall().
 *
 * Modül kaldırıldığında tüm verileri temizler:
 * - Veritabanı tabloları
 * - Drupal config
 * - State değerleri (VAPID anahtarları dahil)
 * - Fiziksel sw.js / manifest.webmanifest dosyaları
 * - Push kuyruğu
 */
function pwa_suite_uninstall(): void {
  $db_schema = \Drupal::database()->schema();

  // Veritabanı tablolarını sil.
  $tables = ['pwa_push_subscription', 'pwa_push_log', 'pwa_push_queue_retry'];
  foreach ($tables as $table) {
    if ($db_schema->tableExists($table)) {
      $db_schema->dropTable($table);
    }
  }

  // Drupal config'i sil.
  \Drupal::configFactory()->getEditable('pwa_suite.settings')->delete();

  // State değerlerini temizle.
  \Drupal::state()->deleteMultiple([
    'pwa_suite.vapid_public_key',
    'pwa_suite.vapid_private_key',
    'pwa_suite.write_error.' . md5('sw.js'),
    'pwa_suite.write_error.' . md5('manifest.webmanifest'),
    'pwa_suite.write_error.' . md5('manifest.json'),
  ]);

  // Push kuyruğunu temizle.
  \Drupal::queue('pwa_suite_push_queue')->deleteQueue();

  // Fiziksel dosyaları sil.
  \Drupal\pwa_suite\PwaStaticFiles::deleteAll();
}

/**
 * sw.js ve manifest.webmanifest'i web root'a yaz (v1.7).
 */
function pwa_suite_update_8107(&$sandbox) {
  try {
    \Drupal\pwa_suite\PwaStaticFiles::writeAll(
      \Drupal::configFactory(),
      \Drupal::state(),
      \Drupal::moduleHandler(),
    );
  }
  catch (\Exception $e) {
    return t('UYARI: Statik dosyalar yazılamadı: @e — Web sunucusunun yazma izni var mı?', ['@e' => $e->getMessage()]);
  }
  return t("PWA Suite v1.7: sw.js ve manifest.webmanifest web root'a yazıldı.");
}

/**
 * sw.js yeniden yaz — 206 Partial Content cache hatası düzeltmesi (v1.8).
 */
function pwa_suite_update_8108(&$sandbox) {
  try {
    \Drupal\pwa_suite\PwaStaticFiles::writeAll(
      \Drupal::configFactory(),
      \Drupal::state(),
      \Drupal::moduleHandler(),
    );
  }
  catch (\Exception $e) {
    return t('UYARI: @e', ['@e' => $e->getMessage()]);
  }
  return t('PWA Suite v1.8: sw.js güncellendi.');
}

/**
 * hook_schema() tanımlandı, retry_count kaldırıldı; FCM 4xx düzeltmesi (v1.9).
 *
 * Mevcut kurulumlar için: pwa_push_log tablosunu güncelle.
 */
function pwa_suite_update_8109(&$sandbox): string {
  $db_schema = \Drupal::database()->schema();

  // pwa_push_log'dan retry_count sütununu kaldır (schema'da yok, ama eski
  // sürümlerde eklenmiş olabilir).
  if ($db_schema->tableExists('pwa_push_log') && $db_schema->fieldExists('pwa_push_log', 'retry_count')) {
    $db_schema->dropField('pwa_push_log', 'retry_count');
  }

  // pwa_push_queue_retry tablosu eksikse oluştur.
  if (!$db_schema->tableExists('pwa_push_queue_retry')) {
    $schema = pwa_suite_schema();
    $db_schema->createTable('pwa_push_queue_retry', $schema['pwa_push_queue_retry']);
  }

  return t('PWA Suite v1.9: Şema düzeltildi, FCM 4xx hatası giderildi.');
}

/**
 * serialize() → JSON migration: pwa_push_queue_retry tablosunu güncelle (v3.0).
 *
 * Eski sürümlerde serialize() ile saklanan message_data değerlerini
 * JSON formatına çevirir. Güvenlik açığını giderir.
 */
function pwa_suite_update_8111(&$sandbox): string {
  $db     = \Drupal::database();
  $count  = 0;
  $errors = 0;

  if (!\Drupal::database()->schema()->tableExists('pwa_push_queue_retry')) {
    return t('pwa_push_queue_retry tablosu yok — atlandı.');
  }

  $rows = $db->select('pwa_push_queue_retry', 'r')
    ->fields('r', ['id', 'message_data'])
    ->execute()
    ->fetchAll();

  foreach ($rows as $row) {
    // Zaten JSON mı?
    $data = json_decode($row->message_data, TRUE);
    if (is_array($data)) {
      continue; // Zaten JSON.
    }

    // PHP serialized string mi?
    $msg = NULL;
    try {
      // PHP 8.0+ - unserialize allowed_classes ile nesne injection engelle.
      $unserialized = @unserialize($row->message_data, ['allowed_classes' => FALSE]);
      if (is_array($unserialized)) {
        $msg = $unserialized;
      }
    }
    catch (\Exception $e) {}

    if ($msg !== NULL) {
      try {
        $db->update('pwa_push_queue_retry')
          ->fields(['message_data' => json_encode($msg, JSON_UNESCAPED_UNICODE)])
          ->condition('id', $row->id)
          ->execute();
        $count++;
      }
      catch (\Exception $e) {
        $errors++;
      }
    }
    else {
      // Parse edilemeyen satırı sil.
      $db->delete('pwa_push_queue_retry')->condition('id', $row->id)->execute();
      $errors++;
    }
  }

  return t('PWA Suite v3.0: @count retry kaydı JSON formatına çevrildi. @errors satır silindi.', ['@count' => $count, '@errors' => $errors]);
}
