    'description' => 'Push bildirim aboneliklerini saklar.',
    'fields' => [
      'id' => [
        'description' => 'Birincil anahtar.',
        'type'        => 'serial',
        'unsigned'    => TRUE,
        'not null'    => TRUE,
      ],
      'uid' => [
        'description' => 'Kullanıcı ID (0 = anonim).',
        'type'        => 'int',
        'unsigned'    => TRUE,
        'not null'    => TRUE,
        'default'     => 0,
      ],
      'endpoint' => [
        'description' => 'Push servis endpoint URL.',
        'type'        => 'varchar',
        'length'      => 2048,
        'not null'    => TRUE,
      ],
      'subscription_hash' => [
        'description' => 'Endpoint\'in SHA-256 hash\'i (tekil kontrol için).',
        'type'        => 'varchar',
        'length'      => 64,
        'not null'    => TRUE,
      ],
      'auth' => [
        'description' => 'Auth anahtarı.',
        'type'        => 'varchar',
        'length'      => 512,
        'not null'    => TRUE,
      ],
      'p256dh' => [
        'description' => 'p256dh açık anahtarı.',
        'type'        => 'varchar',
        'length'      => 512,
        'not null'    => TRUE,
      ],
      'browser' => [
        'description' => 'Tarayıcı türü.',
        'type'        => 'varchar',
        'length'      => 64,
        'not null'    => TRUE,
        'default'     => 'other',
      ],
      'platform' => [
        'description' => 'İşletim sistemi.',
        'type'        => 'varchar',
        'length'      => 64,
        'not null'    => TRUE,
        'default'     => 'other',
      ],
      'status' => [
        'description' => 'Abonelik durumu: 1 = aktif, 0 = pasif.',
        'type'        => 'int',
        'size'        => 'tiny',
        'unsigned'    => TRUE,
        'not null'    => TRUE,
        'default'     => 1,
      ],
      'created' => [
        'description' => 'Kayıt zamanı (Unix timestamp).',
        'type'        => 'int',
        'not null'    => TRUE,
        'default'     => 0,
      ],
      'last_active' => [
        'description' => 'Son aktiflik zamanı (Unix timestamp).',
        'type'        => 'int',
        'not null'    => TRUE,
        'default'     => 0,
      ],
    ],
    'primary key' => ['id'],
    'unique keys'  => ['subscription_hash' => ['subscription_hash']],
    'indexes'      => [
      'uid'    => ['uid'],
      'status' => ['status'],
    ],
  ];

  $schema['pwa_push_log'] = [
    'description' => 'Push bildirim gönderim logları.',
    'fields' => [
      'id' => [
        'description' => 'Birincil anahtar.',
        'type'        => 'serial',
        'unsigned'    => TRUE,
        'not null'    => TRUE,
      ],
      'subscription_id' => [
        'description' => 'İlgili pwa_push_subscription.id.',
        'type'        => 'int',
        'unsigned'    => TRUE,
        'not null'    => TRUE,
        'default'     => 0,
      ],
      'message_hash' => [
        'description' => 'Mesaj içeriğinin SHA-256 hash\'i.',
        'type'        => 'varchar',
        'length'      => 64,
        'not null'    => TRUE,
        'default'     => '',
      ],
      'title' => [
        'description' => 'Bildirim başlığı.',
        'type'        => 'varchar',
        'length'      => 255,
        'not null'    => TRUE,
        'default'     => '',
      ],
      'status' => [
        'description' => 'Gönderim durumu: sent | failed | expired.',
        'type'        => 'varchar',
        'length'      => 32,
        'not null'    => TRUE,
        'default'     => '',
      ],
      'sent_at' => [
        'description' => 'Gönderim zamanı (Unix timestamp).',
        'type'        => 'int',
        'not null'    => TRUE,
        'default'     => 0,
      ],
      'error_message' => [
        'description' => 'Hata mesajı (başarısız gönderimler için).',
        'type'        => 'varchar',
        'length'      => 1000,
        'not null'    => FALSE,
      ],
    ],
    'primary key' => ['id'],
    'indexes'      => [
      'subscription_id' => ['subscription_id'],
