  $schema['pwa_push_queue_retry'] = [
    'description' => 'Başarısız push bildirimler için yeniden deneme kuyruğu.',
    'fields' => [
      'id' => [
        'description' => 'Birincil anahtar.',
        'type'        => 'serial',
        'unsigned'    => TRUE,
        'not null'    => TRUE,
      ],
      'subscription_id' => [
        'description' => 'İlgili pwa_push_subscription.id.',
        'type'        => 'int',
        'unsigned'    => TRUE,
        'not null'    => TRUE,
      ],
      'message_data' => [
        'description' => 'Serialized PwaPushMessage nesnesi.',
        'type'        => 'blob',
        'size'        => 'big',
        'not null'    => TRUE,
